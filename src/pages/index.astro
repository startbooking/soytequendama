---
import Base from '../layouts/Base.astro';
import { publicProviders, ordinaList } from '../lib/format';
import proveedores from '../data/proveedores.json';
import rutas from '../data/rutas.json';
import actividades from '../data/actividades.json';
import indice from '../data/indice.json';

const visibles = publicProviders(proveedores);

const rutasOrdenadas = [...rutas].sort((a, b) => a.ruta_id.localeCompare(b.ruta_id)).slice(0, 3);
const actividadesTeaser = [...actividades]
  .sort((a, b) => a.actividad_id.localeCompare(b.actividad_id))
  .slice(0, 4);

const CATEGORIAS_INFO: Record<string, { icono: string; color: string }> = {
  Hospedaje: { icono: '🏨', color: '#2f5d3c' },
  Restaurante: { icono: '🍽️', color: '#d68a21' },
  'Atractivo turístico': { icono: '🌄', color: '#3f7e86' },
  'Agencia / Operador': { icono: '🎒', color: '#c96f4a' },
};

const conCategoria = (name: string) => visibles.filter((p) => p.categoria === name).length;

const conMunicipio = (name: string) => visibles.filter((p) => p.municipio === name).length;
---

<Base
  title="Mi Región del Tequendama"
  description="Guía turística de la provincia del Tequendama (Cundinamarca, Colombia): proveedores, rutas y actividades."
>
  <section class="hero">
    <div class="contenedor">
      <p class="hero__region">Provincia del Tequendama · Cundinamarca</p>
      <h1 class="hero__titulo">Descubre tu próxima aventura</h1>
      <p class="hero__subtitulo">
        Hospedaje, comida, naturaleza y cultura en Anapoima, La Mesa, Viotá y más municipios.
      </p>

      <form class="hero__buscar" action="/proveedores/" method="get">
        <span class="hero__lupa" aria-hidden="true">🔎</span>
        <input
          class="campo hero__input"
          type="search"
          name="q"
          placeholder="¿Qué estás buscando? Ej. glamping, café…"
          aria-label="Buscar proveedores"
        />
        <button class="btn btn--primario" type="submit">Buscar</button>
      </form>
    </div>
  </section>

  <div class="contenedor">
    <section class="seccion" aria-labelledby="titulo-categorias">
      <h2 id="titulo-categorias">Explora por categoría</h2>
<div class="categorias">
          {indice.categorias.map((c) => {
            const info = CATEGORIAS_INFO[c.name];
            const count = conCategoria(c.name);
            return (
              <a class="categoria" style={`--cat:${info.color}`} href={`/proveedores/?categoria=${encodeURIComponent(c.name)}`}>
                <span class="categoria__icono" aria-hidden="true">{info.icono}</span>
                <span class="categoria__nombre">{c.name}</span>
                <span class="categoria__contador">{count} proveedores</span>
              </a>
            );
          })}
        </div>
    </section>

    <section class="seccion" aria-labelledby="titulo-municipios">
      <h2 id="titulo-municipios">Por municipio</h2>
      <div class="municipios">
        {indice.municipios.map((m) => (
          <a class="chip chip--municipio" href={`/proveedores/?municipio=${encodeURIComponent(m)}`}>
            {m}
            <span class="municipios__count">{conMunicipio(m)}</span>
          </a>
        ))}
      </div>
      <p class="texto-suave seccion__nota">
        “Zona de influencia”: sitios emblemáticos cercanos a la provincia (Soacha), incluidos por ser
        parte del paisaje del Tequendama.
      </p>
    </section>

    <section class="seccion" aria-labelledby="titulo-rutas">
      <div class="seccion__encabezado">
        <h2 id="titulo-rutas">Rutas sugeridas</h2>
        <a class="seccion__ver" href="/rutas/">Ver todas →</a>
      </div>
      <div class="teasers">
        {rutasOrdenadas.map((ruta) => (
          <a class="teaserr tarjeta" href={`/rutas/${ruta.ruta_id}/`}>
            <span class="badge-sugerida">Ruta sugerida</span>
            <h3>{ruta.nombre}</h3>
            <p class="teaserr__meta">
              {ruta.tipo} · {ruta.duracion_sugerida} · {ruta.n_paradas} paradas
            </p>
            <p class="teaserr__chips">
              {ordinaList(ruta.municipios).map((m) => (
                <span class="chip chip--municipio">{m}</span>
              ))}
            </p>
          </a>
        ))}
      </div>
    </section>

    <section class="seccion" aria-labelledby="titulo-actividades">
      <div class="seccion__encabezado">
        <h2 id="titulo-actividades">Actividades sugeridas</h2>
        <a class="seccion__ver" href="/actividades/">Ver todas →</a>
      </div>
      <div class="actividades">
        {actividadesTeaser.map((a) => (
          <a class="teasera tarjeta" href="/actividades/">
            <span class="badge-sugerida">Actividad sugerida</span>
            <h3>{a.nombre}</h3>
            <p class="teasera__meta">
              <span class="chip chip--municipio">{a.municipio}</span>
              {a.tipo}
            </p>
            {a.precio && a.precio !== 'Por definir' && <p class="teasera__precio">{a.precio}</p>}
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    background:
      radial-gradient(900px 420px at 88% -12%, rgba(232, 160, 60, 0.35), transparent 60%),
      radial-gradient(760px 400px at -5% 115%, rgba(63, 126, 134, 0.42), transparent 55%),
      linear-gradient(155deg, var(--bosque-700), var(--bosque-900) 70%);
    padding: 2.6rem 0 3rem;
    margin-bottom: 1.6rem;
    color: #fff;
  }

  .hero__region {
    margin: 0 0 0.3rem;
    color: var(--arena-200);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .hero__titulo {
    font-size: 2.3rem;
    margin: 0 0 0.5rem;
    color: #fff;
    font-family: var(--font-display);
  }

  .hero__subtitulo {
    margin: 0 0 1.4rem;
    font-size: 1.04rem;
    color: rgba(255, 255, 255, 0.86);
  }

  .hero__buscar {
    display: flex;
    gap: 0.4rem;
    align-items: stretch;
    background: #fff;
    border-radius: 999px;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.22);
  }

  .hero__lupa {
    display: none;
  }

  .hero__input {
    flex: 1;
    border: 0;
    background: transparent;
    box-shadow: none;
    padding: 0.7rem 0.4rem;
  }

  .hero__input:focus {
    box-shadow: none;
  }

  .hero__buscar .btn {
    border-radius: 999px;
  }

  .seccion {
    margin-bottom: 2rem;
  }

  .seccion__nota {
    font-size: 0.85rem;
    margin: 0.8rem 0 0;
  }

  .categorias {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .categoria {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background:
      radial-gradient(240px 160px at 100% 0%, rgba(255, 255, 255, 0.22), transparent 60%),
      linear-gradient(150deg, var(--cat), var(--bosque-900) 85%);
    color: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 1rem;
    text-decoration: none;
    min-width: 0;
  }

  .categoria:active {
    transform: scale(0.985);
  }

  .categoria__icono {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .categoria__nombre {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
    color: #fff;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .categoria__contador {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
  }

  .municipios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .municipios__count {
    font-weight: 400;
    opacity: 0.75;
  }

  .seccion__encabezado {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }

  .seccion__encabezado h2 {
    margin: 0;
  }

  .seccion__ver {
    font-weight: 700;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .teasers {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .teaserr {
    display: block;
    padding: 1rem 1.1rem;
    color: var(--texto);
  }

  .teaserr h3 {
    margin: 0.55rem 0 0.3rem;
    font-size: 1rem;
  }

  .teaserr__meta {
    margin: 0 0 0.5rem;
    color: var(--texto-suave);
    font-size: 0.85rem;
  }

  .teaserr__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .actividades {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .teasera {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 0.95rem;
    color: var(--texto);
    min-width: 0;
  }

  .teasera h3 {
    font-size: 0.95rem;
    margin: 0.5rem 0 0.45rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .teasera__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  .teasera__precio {
    margin: auto 0 0;
    color: var(--verde-700);
    font-weight: 700;
    font-size: 0.82rem;
  }

  @media (min-width: 520px) {
    .hero__buscar {
      max-width: 480px;
    }

    .categorias {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .categoria__nombre {
      display: block;
    }
  }
</style>