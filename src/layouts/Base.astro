---
import type { Proveedor } from '../lib/format';

interface Props {
  title: string;
  description: string;
  providers?: Proveedor[];
}

const { title, description } = Astro.props;
const siteTitle = 'Mi Región del Tequendama';
const pageTitle = title === siteTitle ? siteTitle : `${title} · ${siteTitle}`;

function linkTo(path: string) {
  return new URL(path, Astro.url.origin).pathname;
}

const path = Astro.url.pathname;
const NAV = [
  { href: '/', label: 'Inicio', match: (p: string) => p === '/' },
  { href: '/proveedores/', label: 'Directorio', match: (p: string) => p.startsWith('/proveedores') },
  { href: '/rutas/', label: 'Rutas', match: (p: string) => p.startsWith('/rutas') },
  { href: '/actividades/', label: 'Actividades', match: (p: string) => p.startsWith('/actividades') },
  { href: '/mapa/', label: 'Mapa', match: (p: string) => p.startsWith('/mapa') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#234d3d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'http://soytequenda.lan').toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mi Región del Tequendama" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og.png" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Figtree:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --verde-900: #1f2a1e;
        --verde-700: #27503a;
        --verde-600: #2f5d3c;
        --verde-500: #3e7a4e;
        --verde-100: #e3ede2;
        --bosque-900: #172b24;
        --bosque-700: #234d3d;
        --arena-500: #c9b18a;
        --arena-200: #f0e7d6;
        --arena-100: #f7f1e4;
        --arena-50: #f9f6f1;
        --tarjeta: #fcfbf8;
        --ambar-700: #b57114;
        --ambar-500: #e8a03c;
        --teal-600: #3f7e86;
        --terracota-500: #c96f4a;
        --texto: #172b24;
        --texto-suave: #63746d;
        --borde: #e4dccb;
        --font: "Figtree", "DM Sans", ui-sans-serif, system-ui, -apple-system,
          "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-display: "Fraunces", Georgia, "Times New Roman", serif;
        --radius-lg: 16px;
        --radius: 12px;
        --radius-sm: 10px;
        --shadow: 0 2px 10px rgba(23, 43, 36, 0.08);
        --shadow-lg: 0 10px 30px rgba(23, 43, 36, 0.14);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: var(--arena-50);
        color: var(--texto);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: var(--verde-600);
        text-decoration: none;
      }

      h1,
      h2,
      h3 {
        margin: 0 0 0.5rem;
        color: var(--verde-900);
        line-height: 1.15;
        font-family: var(--font-display);
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      h1 {
        font-size: 2rem;
      }
      h2 {
        font-size: 1.45rem;
      }
      h3 {
        font-size: 1.05rem;
      }

      .contenedor {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 0 1rem;
      }

      .texto-suave {
        color: var(--texto-suave);
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: var(--arena-100);
        border: 1px solid var(--borde);
        color: var(--texto);
        border-radius: 999px;
        padding: 0.25rem 0.7rem;
        font-size: 0.8rem;
        white-space: nowrap;
      }

      .chip--municipio {
        background: var(--verde-100);
        border-color: transparent;
        color: var(--verde-700);
        font-weight: 600;
      }

      .chip--influencia {
        background: var(--arena-200);
        color: #8a6d3b;
        border-color: var(--arena-500);
      }

      .badge-sugerida {
        background: var(--ambar-500);
        color: var(--verde-900);
        font-weight: 700;
        border-radius: 999px;
        padding: 0.2rem 0.7rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .oculto {
        display: none !important;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        font: inherit;
        font-weight: 700;
        border: 0;
        border-radius: var(--radius);
        padding: 0.8rem 1.1rem;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: transform 0.05s ease, box-shadow 0.15s ease;
      }

      .btn:active {
        transform: scale(0.98);
      }

      .btn--primario {
        background: var(--verde-600);
        color: #fff;
        box-shadow: 0 2px 8px rgba(47, 93, 60, 0.3);
      }

      .btn--ambar {
        background: var(--ambar-500);
        color: var(--verde-900);
      }

      .btn--claro {
        background: var(--arena-100);
        color: var(--verde-700);
        border: 1px solid var(--borde);
      }

      .btn--block {
        width: 100%;
      }

      .campo {
        width: 100%;
        font: inherit;
        font-size: 1rem;
        border: 1px solid var(--borde);
        border-radius: var(--radius);
        background: #fff;
        color: var(--texto);
        padding: 0.8rem 1rem;
        outline: none;
      }

      .campo:focus {
        border-color: var(--verde-600);
        box-shadow: 0 0 0 3px rgba(62, 122, 78, 0.18);
      }

      .tarjeta {
        background: var(--tarjeta);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor cabecera__inner">
        <a class="cabecera__marca" href={linkTo('/')}>
          <img class="cabecera__logo" src="/favicon.svg" width="40" height="40" alt="" />
          <span class="cabecera__texto">
            <span class="cabecera__linea1">Mi Región del</span>
            <span class="cabecera__linea2">Tequendama</span>
          </span>
        </a>
        <nav class="cabecera__nav">
          {
            NAV.map((item) => (
              <a href={linkTo(item.href)} aria-current={item.match(path) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a class="cabecera__admin" href="/admin/">Administración</a>
        </nav>
      </div>
    </header>

    <style is:global>
      .cabecera {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(250, 246, 238, 0.92);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--borde);
      }

      .cabecera__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        row-gap: 0.2rem;
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;
      }

      .cabecera__marca {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--verde-700);
        font-weight: 800;
        min-width: 0;
      }

      .cabecera__logo {
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 8px;
        flex-shrink: 0;
      }

      .cabecera__texto {
        display: flex;
        flex-direction: column;
        line-height: 1.05;
        min-width: 0;
      }

      .cabecera__linea1 {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--verde-700);
        white-space: nowrap;
      }

      .cabecera__linea2 {
        font-size: 1.16rem;
        font-weight: 800;
        line-height: 1.15;
        font-family: var(--font-display);
        letter-spacing: -0.01em;
        white-space: nowrap;
      }

      .cabecera__nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        margin-left: auto;
      }

      .cabecera__nav a {
        font-weight: 600;
        color: var(--texto-suave);
        padding: 0.35rem 0.55rem;
        border-radius: var(--radius-sm);
      }

      .cabecera__nav a[aria-current="page"] {
        color: var(--verde-700);
        background: var(--verde-100);
      }

      .cabecera__nav .cabecera__admin {
        margin-left: 0.35rem;
        font-weight: 700;
        color: var(--verde-700);
        border: 1px solid var(--verde-600);
        border-radius: 999px;
        padding: 0.4rem 0.8rem;
        white-space: nowrap;
      }
    </style>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p class="pie__marca">Mi Región del Tequendama</p>
        <p class="pie__texto">
          Turismo local de la provincia del Tequendama · Cundinamarca (Colombia).
        </p>
        <p class="pie__texto">
          Los datos se actualizan desde los archivos de la provincia (directorio, rutas y
          actividades) y se cargan con la información que los proveedores comparten en Google.
          Siempre confirma con el proveedor antes de ir.
        </p>
      </div>
    </footer>

    <style is:global>
      .pie {
        background: var(--bosque-900);
        color: var(--arena-100);
        margin-top: 3rem;
        padding: 1.6rem 0 2rem;
      }

      .pie__marca {
        margin: 0 0 0.3rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.1rem;
      }

      .pie__texto {
        margin: 0.3rem 0;
        font-size: 0.85rem;
        color: var(--arena-200);
        line-height: 1.55;
      }
    </style>
  </body>
</html>