# Copia este archivo a .env y completa los valores (no lo subas a git).

# Contraseña del panel /admin/ (se compara como SHA-256 en el cliente;
# solo su hash se incluye en el build).
ADMIN_PASSWORD=

# Credenciales de MySQL para `npm run migrate:mysql` y la API PHP (api/).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=mi_region_tequendama

# Usuario super-admin inicial (se crea con `php scripts/crear-usuario.php`).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=